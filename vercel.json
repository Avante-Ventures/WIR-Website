{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.wirinnovation.ai"
        }
      ],
      "destination": "https://wirinnovation.ai/$1",
      "permanent": true
    },
    {
      "source": "/es/insights/:path*",
      "destination": "/insights/:path*",
      "permanent": false
    },
    {
      "source": "/dashboard/",
      "destination": "https://dashboard.wirinnovation.ai/",
      "permanent": false
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://dashboard.wirinnovation.ai/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
